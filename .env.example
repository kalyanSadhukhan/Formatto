# Formatto Environment Configuration Template
# Copy this file to .env in local development or set as environment variables in deployment.

# Application Settings
PROJECT_NAME="AI Document Formatting Platform"
LOG_LEVEL="INFO"

# Database Configuration
DATABASE_URL="sqlite:///./formatto.db"

# Storage Settings
STORAGE_PATH="/tmp/formatto"
MAX_FILE_SIZE_BYTES=10485760

# LLM Provider Credentials (Optional: used for ambiguous classification fallback; rule-based engine operates deterministically without keys)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""

# CORS Origins (Comma-separated or JSON list of origins; default allows local frontend)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Frontend Configuration (for Vite frontend)
# VITE_API_BASE_URL=""
